# ---------------------------------------------------------------------------
# Local development environment variables.
# Copy to `.env` and fill in. NEVER commit the populated `.env` file.
#
# In Azure Databricks these values come from a *secret scope* backed by
# Azure Key Vault, NOT from this file (see src/tokyo_olympics/secrets.py).
# ---------------------------------------------------------------------------

# Pipeline environment: dev | prod  (selects conf/<env>.yaml)
TOKYO_ENV=dev

# Service principal credentials for ADLS Gen2 OAuth (cloud runs only).
# Locally these are unused because dev runs against ./data.
ADLS_TENANT_ID=
ADLS_CLIENT_ID=
ADLS_CLIENT_SECRET=

# Override storage account/container without editing YAML (optional).
# TOKYO_STORAGE__ACCOUNT_NAME=tokyoolympicdata
# TOKYO_STORAGE__CONTAINER=tokyo-olympic-data
